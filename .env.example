# Copy to .env and set a randomly generated local password.
POSTGRES_PASSWORD=
POSTGRES_PORT=5438
DATABASE_URL=postgresql://forge_sbd:CHANGE_ME@127.0.0.1:5438/forge_sbd
TEST_DATABASE_URL=postgresql://forge_sbd:CHANGE_ME@127.0.0.1:5438/forge_sbd_test
WEB_ORIGIN=http://localhost:5173
API_PORT=3000

# API/frontend run locally; Docker runs only PostgreSQL.
# Tests clean only the dedicated local *_test database; never reuse production data.
